{
  "name": "playwright_e2e_test_ca",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "debug-api-adv-cap-login": "set DEBUG=pw:api && npx playwright test tests/demo/pw.adv.cap.login.spec.ts",
    "pw-adv-cap-login": "npx playwright test tests/demo/pw.adv.cap.login.spec.ts --headed",
    "demo-tag-regression": "npx playwright test --grep \"@regression\" --headed",
    "demo-tag-smoke": "npx playwright test --grep \"@smoke\" --headed",
    "pw-basic-cap-make-appt": "npx playwright test tests/demo/pw.basic.cap.make.appt.spec --headed",
    "debug-trace-make-appt": "npx playwright test tests/demo/debug.make.appt.spec.ts --trace on",
    "debug-cli-make-appt": "set PWDEBUG=1 && npx playwright test tests/demo/debug.make.appt.spec.ts",
    "debug-ui-make-appt": "npx playwright test tests/demo/debug.make.appt.spec.ts --ui --headed",
    "debug-make-appt": "npx playwright test tests/demo/debug.make.appt.spec.ts --headed",
    "assign-checkout": "npx playwright test tests/demo/checkout.flow.spec.ts --headed",
    "inventory-price": "npx playwright test tests/functional/inventory.spec.ts --headed",
    "element-handling": "npx playwright test tests/demo/element.handling.make.appt.spec.ts --headed",
    "make-appt": "npx playwright test tests/functional/make.appt.spec.ts --headed",
    "login": "npx playwright test tests/functional/login.spec.ts --headed",
    "demo": "npx playwright test tests/demo/mytest.spec.ts --headed"
  },
  "keywords": [],
  "author": "Amul Sinfal",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "allure-playwright": "^3.12.0"
  }
}
